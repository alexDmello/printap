# ==========================================
# Printap — Central Environment Template
# ==========================================

# ── Supabase Configuration ────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Authentication & Security ─────────────
# 32+ character cryptographically secure secret used for signing print tickets
PRINTAP_JWT_SECRET=your-random-32-char-jwt-secret-here
# Secret key used by platform administrators / executive console
PRINTAP_ADMIN_SECRET=your-secure-admin-secret-here

# ── Email Service (Resend) ────────────────
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=onboarding@resend.dev

# ── Multi-Tenant Domain Settings ──────────
NEXT_PUBLIC_ROOT_DOMAIN=mellod.in
NEXT_PUBLIC_DESKTOP_DOWNLOAD_URL=https://github.com/your-org/printap/releases/latest

# ── Desktop Agent & Admin Console (Vite) ──
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_PRINTAP_ADMIN_SECRET=your-secure-admin-secret-here
